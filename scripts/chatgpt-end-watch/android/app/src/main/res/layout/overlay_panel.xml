<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="8dp">

    <TextView
        android:id="@+id/overlayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jinx Watch"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/overlayState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="…"
        android:textColor="#C7D2FE"
        android:textSize="12sp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnOverlayStart"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/go"
            android:text="@string/start"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnOverlayStop"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/stop"
            android:text="@string/stop"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>

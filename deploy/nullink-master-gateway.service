[Unit]
Description=Nullink master admin MCP gateway
After=nullink-master-worker.service
Requires=nullink-master-worker.service

[Service]
Type=simple
User=nullink-master
Group=nullink-master
WorkingDirectory=/opt/nullink-master
Environment=MASTER_TOKEN_FILE=/etc/nullink-master/admin-token
Environment=NULLINK_TOKEN_FILE=/etc/nullink-master/chat-token
Environment=NULLINK_URL=http://127.0.0.1:8766
Environment=MASTER_PORT=8768
ExecStart=/usr/bin/python3 /opt/nullink-master/master_gateway.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

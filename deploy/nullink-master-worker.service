[Unit]
Description=Nullink master Codex job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=nullink-master
WorkingDirectory=/opt/nullink-master
Environment=MASTER_CONFIG=/etc/nullink-master/config.json
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /opt/nullink-master/master_worker.py
RuntimeDirectory=nullink-master
RuntimeDirectoryMode=0750
StateDirectory=nullink-master
StateDirectoryMode=0700
UMask=0077
KillMode=control-group
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
